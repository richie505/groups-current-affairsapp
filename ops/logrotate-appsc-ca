# Log rotation for the files this app writes outside journald.
#
# Installed to /etc/logrotate.d/appsc-ca by ops/deploy.sh.
#
# None of the three grow fast — the backup log is a couple of lines a night,
# the certbot hook writes one line every sixty days, and the watchdog log
# (ops/watchdog.sh) writes nothing at all in the common case, only when it had
# to act. All three are unbounded left alone, and an unbounded file on the
# same disk as the database is the kind of thing that is fine for a year and
# then is not.
#
# `missingok` because the certbot log does not exist until the first renewal
# and the watchdog log does not exist until it first has something to say —
# logrotate treating either as an error would put a failure in the daily mail
# for something entirely normal.

/var/log/appsc-ca-backup.log
/var/log/certbot-deploy.log
/var/log/appsc-ca-watchdog.log {
    # ROTATE AS ROOT, EXPLICITLY.
    #
    # /var/log on Ubuntu is root:syslog and group-writable, and logrotate
    # refuses to touch a file whose parent directory is writable by a group
    # other than root unless told whose authority to use. Without this it
    # silently skips both files with:
    #   error: skipping "..." because parent directory has insecure permissions
    # — a rotation that is configured, enabled, and does nothing.
    su root root
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    # The writers append and never hold the file open, so there is no signal to
    # send and nothing to reopen. copytruncate would risk losing lines written
    # between the copy and the truncate, for no benefit here.
    create 0640 appsc-ca appsc-ca
}
