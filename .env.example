# Copy to .env (gitignored) and fill in.

# Required only for the AI drafting pipeline (content-pipeline/ca-daily).
# The app itself runs without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SHORTLIST_MODEL=gpt-5.6-luna

# ---- A second provider, for the cheap job only (optional) ----
#
# The chat-completions API is the same shape at DeepSeek, Together, Groq and
# most others, so a provider here is a base URL, a key, and the list of model
# names to route to it. Leave ALT_BASE_URL blank and everything runs on OpenAI.
#
# WHICH JOBS ARE SAFE TO MOVE
#
# Shortlisting is: judgement over forty supplied headlines, no recall, and a
# wrong call loses one article the next day's paper will cover anyway. Safe.
#
# Drafting is NOT. It writes the static notes — Articles, sections, landmark
# cases, AP schemes — from the model's own knowledge, and a cheap model that
# invents there teaches a candidate something false with total confidence.
# Measured August 2026: DeepSeek V4-Flash hallucinates on 96% of knowledge
# questions. Keep drafting on the better model; the whole month costs about
# $4 either way.
#
# ALT_BASE_URL=https://api.deepseek.com/v1
# ALT_API_KEY=
# ALT_MODELS=deepseek-v4-flash
# OPENAI_SHORTLIST_MODEL=deepseek-v4-flash

# Sign the session tokens. Set this to something long and random in production —
# without it the server falls back to a well-known development secret.
JWT_SECRET=

# Comma-separated origins allowed to call the API cross-origin. Leave blank:
# the frontend is served by the same process and needs no CORS at all.
CORS_ORIGINS=

PORT=4100

# ---- Accounts ----
#
# Whether anyone with the URL can sign themselves up. Open by default, which is
# what this app has always done. Every item in the app cost money to draft, and
# the admin screen already has the other model built — create the student, send
# them a reset link — so a private deployment should set this to 0.
ALLOW_REGISTRATION=1

# New accounts per IP per hour. Generous for a household or a college behind one
# address, useless for a script.
MAX_SIGNUPS_PER_HOUR=5

# ---- Operations ----
#
# "production" is not cosmetic: it is what turns a missing JWT_SECRET from a
# warning into a refusal to start.
NODE_ENV=production

# Log every request, not just errors and anything slower than SLOW_REQUEST_MS.
# The log records no IP, no query string and no email by design.
LOG_ALL_REQUESTS=0
SLOW_REQUEST_MS=1000

# How long one model call may take before it is abandoned and retried.
OPENAI_TIMEOUT_MS=180000
